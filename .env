# Renomeie este arquivo para ".env" para configurar seu ambiente.
# Se nenhum PostgreSQL for informado, o sistema utilizará automaticamente
# o SQLite nativo embutido (db/notas_conserto.sqlite), sem necessidade de instalar nada!

# Banco PostgreSQL (opcional para ambiente de produção / empresa):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=notas_conserto
# PGUSER=postgres
# PGPASSWORD=sua_senha
# USE_SQLITE=false

PORT=3000

# Prazos padrão de cada etapa (em dias) - configuráveis sem mexer no código
PRAZO_RC_DIAS=30               # Orçamento/Nota emitida -> Criação da RC
PRAZO_PC_DIAS=15               # RC criada -> Pedido de Compras (PC)
PRAZO_ENVIO_CONSERTO_DIAS=10   # Pedido criado -> Início/Envio ao conserto
PRAZO_CONSERTO_DIAS=45         # Conserto em andamento no fornecedor

# Níveis de urgência global (em meses, contados a partir da emissão/orçamento)
URGENCIA_ATENCAO_MESES=4       # 4 meses -> Atenção
URGENCIA_URGENTE_MESES=5       # 5 meses -> Urgente
URGENCIA_MULTA_MESES=6         # 6 meses -> Risco de Multa contratual
